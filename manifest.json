   "icons": {
      "128": "icons/nsu-cgpa-128.png",
      "16": "icons/nsu-cgpa-16.png",
      "48": "icons/nsu-cgpa-48.png"
   },
   "manifest_version": 3,
   "name": "NSU CGPA CALCULATOR",
   "permissions": [ "storage" ],
   "version": "0.1.2"
}
