{
   "action": {
      "default_icon": {
         "16": "icons/nsu-cgpa-16.png",
         "48": "icons/nsu-cgpa-48.png"
      },
      "default_popup": "popup.html"
   },
   "content_scripts": [ {
      "js": [ "content-script.js" ],
